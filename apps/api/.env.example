ENV=development
ADDR=:8080
BASE_URL=http://localhost:8080
DATABASE_URL=postgres://waytutor:waytutor@localhost:5432/waytutor?sslmode=disable
LOG_LEVEL=info

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_STATE_SECRET=

AI_GATEWAY_API_KEY=

# R2 is optional locally: without these four the audio cache goes to CACHE_DIR.
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_BUCKET=waytutor-audio
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_REGION=auto

MONTHLY_CHARS_PER_ACCOUNT=500000
GLOBAL_MONTHLY_CHARS=6000000
MONTHLY_SUMMARIES_PER_ACCOUNT=200
RATE_PER_MINUTE=40

# Enables the admin endpoints. Without it they do not exist.
ADMIN_TOKEN=
